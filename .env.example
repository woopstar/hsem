# Settings for scripts/collect_actuals.sh (see docs/backtest-runbook.md).
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. The script parses this file rather than sourcing it, so
# values are taken literally -- no need to escape $ or quotes in the token.
# Anything already exported in your shell overrides what is set here.

# Home Assistant base URL, as reachable from this machine.
HA_URL=http://homeassistant.local:8123

# Long-lived access token: HA profile -> Security -> Long-lived access tokens.
HA_TOKEN=

# scripts/backtest_update.sh copies the live corpus off Home Assistant with scp.
# Leave HA_SSH_HOST empty to copy it yourself. Key-based SSH login avoids a
# password prompt on every run.
HA_SSH_HOST=
HA_SSH_PORT=22
HA_SSH_USER=root
HA_CORPUS_PATH=/config/hsem-corpus.jsonl

# Which installation this collection is from. Written as "site" to every
# committed cycle and actuals file, so a plan is only ever compared with the
# meters of the same house (issue #1225). It is committed to a public
# repository: pick a label that tells your installations apart and says nothing
# else. Lower-case letters, digits and hyphens, at most 32 characters.
# Without it nothing is committed.
HSEM_BACKTEST_SITE=site-a

# Where the live corpus is kept locally.
# HSEM_BACKTEST_CORPUS=~/hsem-actuals/corpus

# Must match Home Assistant's time zone, or day boundaries shift. Also fills
# the time_zone field into dumps from before #1169 when they are committed.
TZ=Europe/Copenhagen

# Extra entities to download but not convert. The recorder purges, so these
# cannot be fetched later: EV charger power, EV SoC, phase meters, and the
# applied working mode are worth keeping for Stage 2b.
HSEM_ARCHIVE_ENTITIES=

# Override a mapped entity only if yours is named differently from the common
# HSEM template package. Series names are fixed; see MAPPING in the script.
# HSEM_GRID_IMPORT_ENTITY=sensor.energy_import_ps
# HSEM_GRID_EXPORT_ENTITY=sensor.energy_export_ps
# HSEM_PV_ENTITY=sensor.energy_yield_1_ps
# HSEM_HOUSE_LOAD_ENTITY=sensor.energy_house_load_yield_without_ev_ps
# HSEM_BATTERY_CHARGE_ENTITY=sensor.energy_battery_charge_ps
# HSEM_BATTERY_DISCHARGE_ENTITY=sensor.energy_battery_discharge_ps
# HSEM_BATTERY_SOC_ENTITY=sensor.batteries_state_of_capacity
# HSEM_IMPORT_PRICE_ENTITY=sensor.energi_data_service
# HSEM_EXPORT_PRICE_ENTITY=sensor.energi_data_service_produktion
